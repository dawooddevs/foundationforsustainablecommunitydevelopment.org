# Apache / SiteGround configuration
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS — uncomment once SSL is active on the domain
  # (SiteGround: Site Tools → Security → HTTPS Enforce does the same)
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block private folders and files
  RewriteRule ^(app|scripts|docs|node_modules)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule (^|/)[^/]+\.md$ - [F,L]
  RewriteRule ^(package(-lock)?\.json|composer\.(json|lock))$ - [F,L]

  # Real files and folders are served directly; everything else goes to the router
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|woff|css|js|svg|webp|avif|jpg|jpeg|png|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/avif .avif

# Allow media uploads up to 100 MB. SiteGround (PHP-FPM) reads .user.ini; this block covers mod_php hosts.
<IfModule mod_php.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 105M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
